# Salin ke .env lalu isi. Jangan commit .env.

# Kunci enkripsi Payload. Wajib. Buat dengan: openssl rand -hex 32
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang

# Basis data. "sqlite" untuk pengembangan lokal, "postgres" untuk produksi.
DATABASE_ADAPTER=sqlite

# Dipakai bila DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./penerbit.db

# Dipakai bila DATABASE_ADAPTER=postgres
# DATABASE_URL=postgres://penerbit:rahasia@localhost:5432/penerbit

# URL publik situs, tanpa garis miring di akhir (canonical, sitemap, OG). Dibaca saat runtime.
SITE_URL=http://localhost:3000


# Admin lokal: ADMIN_BASE_URL dipakai daftar CSRF Payload (dev otomatis menambah http://localhost:3000).
# ADMIN_BASE_URL=http://localhost:3000

# Turnstile (opsional; kosong = tanpa Turnstile)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
