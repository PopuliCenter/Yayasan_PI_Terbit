# .env stack VPS — salin ke .env (chmod 600). NAMA variabel saja; nilai rahasia diisi di VPS.
# Rahasia acak dibuat dengan perintah di docs/DEPLOY.md §6 (openssl rand -hex 32), tidak ditampilkan di layar.
#
# ATURAN BERKAS INI: komentar SELALU di baris sendiri, JANGAN di belakang nilai.
# Compose membuang komentar sebaris, tetapi perintah shell runbook (grep | cut) tidak.
# Baris "# staging:" di atas variabel = nilai untuk /var/www/toko-buku-staging.

# ---- Identitas stack ----
# staging: toko-staging
STACK_NAME=toko
# staging: toko-staging-proxy
PROXY_CONTAINER_NAME=toko-proxy
# staging: staging-admin.<DOMAIN_TOKO>
ADMIN_HOST=admin.<DOMAIN_TOKO>
# ghcr.io/<pemilik>, huruf kecil semua
IMAGE_REPO=ghcr.io/<GHCR_OWNER>
# sha-<SHA commit penuh> yang CI-nya hijau dan job publish sukses
IMAGE_TAG=sha-<SHA>
# docker network inspect web --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
WEB_SUBNET=<WEB_SUBNET>
# staging: toko-staging_db_data
DB_VOLUME=toko_db_data
# staging: toko-staging_files
FILES_VOLUME=toko_files
# staging: WAJIB aktifkan baris berikut (hapus "# " di depannya)
# COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml

# ---- Database ----
DB_NAME=toko
DB_USER=toko
# staging: nilai acak baru
DB_PASSWORD=<ACAK>

# ---- Aplikasi ----
# staging: nilai acak baru. Mengganti nilai ini memaksa semua admin login ulang.
PAYLOAD_SECRET=<ACAK>
# staging: https://staging.<DOMAIN_TOKO>
PUBLIC_BASE_URL=https://<DOMAIN_TOKO>
# staging: https://staging-admin.<DOMAIN_TOKO>
ADMIN_BASE_URL=https://admin.<DOMAIN_TOKO>
# staging: false — app MENOLAK start bila STACK_NAME memuat "staging" dan nilai ini true
SITE_INDEXABLE=true

# ---- Gerbang admin: Cloudflare Access (bukan rahasia) ----
# Kosong = SEMUA permintaan ke host admin ditolak (gagal tertutup).
CF_ACCESS_TEAM_DOMAIN=<TIM>.cloudflareaccess.com
# staging: AUD aplikasi Access staging (berbeda dari produksi)
CF_ACCESS_AUD=<AUD_TAG>

# ---- Anti-bot formulir: Cloudflare Turnstile ----
# Disarankan diisi di produksi (lapisan yang benar-benar menahan klien skrip).
# Kosong = honeypot + token waktu + batas laju saja.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
